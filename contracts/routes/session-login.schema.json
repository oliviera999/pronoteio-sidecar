{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "session-login.schema.json",
  "title": "POST /session/login",
  "method": "POST",
  "url": "/session/login",
  "fixture": "fixtures/session-login-reused.json",
  "properties": {
    "response": {
      "type": "object",
      "properties": {
        "sessionid": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "displayname": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "reused": {
          "const": true
        },
        "space": {
          "enum": [
            "mobile",
            "web"
          ],
          "description": "0.10.0 : espace de la session ouverte."
        },
        "login": {
          "enum": [
            "token",
            "credentials"
          ],
          "description": "0.10.0 : mode de connexion."
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "0.10.0 : onglets de la session (listeOnglets)."
        }
      },
      "required": [
        "sessionid",
        "displayname",
        "version"
      ],
      "additionalProperties": false,
      "description": "« token » (jeton à usage unique, à conserver) est toujours renvoyé pour l'espace mobile ; une session de l'Espace Professeurs web (space: web, 0.10.0) n'en donne pas."
    }
  }
}
