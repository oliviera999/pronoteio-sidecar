              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "ratings": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "student",
                "skill",
                "level"
              ],
              "properties": {
                "student": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "skill": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "observation": {
                  "type": "string",
                  "maxLength": 1000
                },
                "published": {
                  "type": "boolean"
                }
              }
            }
          },
          "delete": {
            "type": "boolean",
            "default": false
          },
          "cycleReport": {
            "type": "boolean"
          },
          "defaultLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "dryRun": {
            "type": "boolean",
            "default": false
          },
          "force": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "signed": true
    },
