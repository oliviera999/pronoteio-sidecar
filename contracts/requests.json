    },
    {
      "method": "POST",
      "url": "/competencies",
      "body": {
        "type": "object",
        "required": [
          "service",
          "period"
        ],
        "properties": {
          "assessment": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "date": {
            "type": "integer",
            "minimum": 0
          },
          "publication": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "coefficient": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "skills": {
            "type": "array",
            "maxItems": 50,
