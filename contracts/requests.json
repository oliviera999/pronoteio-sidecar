    {
      "method": "POST",
      "url": "/grades",
      "body": {
        "type": "object",
        "required": [
          "service",
          "period",
          "assessment",
          "grades"
        ],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "dryRun": {
            "type": "boolean"
          },
          "assessment": {
            "type": "object",
            "required": [
              "title",
              "date",
              "max",
              "coefficient"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "date": {
                "type": "integer",
                "minimum": 0
              },
              "publication": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "coefficient": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "scaleTo20": {
                "type": "boolean",
                "default": false
              },
              "optional": {
                "type": "boolean",
                "default": false
              },
              "bonus": {
                "type": "boolean",
                "default": false
              },
              "comment": {
                "type": "string",
                "maxLength": 1000,
                "default": ""
              },
              "delete": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "grades": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "studentid"
              ],
              "properties": {
                "studentid": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "default": null
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "",
                    "abs",
                    "disp",
                    "nonnote",
                    "inapte",
                    "nonrendu",
                    "abszero",
                    "nonrenduzero"
                  ],
                  "default": ""
                }
              }
            }
          }
        }
      },
      "signed": true
    },
