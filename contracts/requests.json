{
  "note": "Schémas des requêtes de toutes les routes, extraits du code (npm run contracts:requests). /health : signée pour le rapport complet.",
  "routes": [
    {
      "method": "GET",
      "url": "/absences",
      "querystring": {
        "type": "object",
        "required": [
          "resource",
          "from",
          "to"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "signed": true
    },
    {
      "method": "POST",
      "url": "/absences",
      "body": {
        "type": "object",
        "required": [
          "lesson",
          "items"
        ],
        "properties": {
          "lesson": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "student",
                "kind"
              ],
              "properties": {
                "student": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "absence",
                    "late"
                  ]
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "delete": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "done": {
            "type": "boolean"
          },
          "dryRun": {
            "type": "boolean",
            "default": false
          },
          "force": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "signed": true
    },
    {
      "method": "GET",
      "url": "/admin/update",
      "signed": true
    },
    {
      "method": "POST",
      "url": "/admin/update",
      "body": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300
          }
        }
      },
      "signed": true
    },
    {
      "method": "GET",
