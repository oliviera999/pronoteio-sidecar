{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Définitions communes des contrats pronoteio-sidecar",
  "definitions": {
    "localTimes": {
      "type": "object",
      "description": "0.9.0 : heures murales de Pronote (« 2026-11-12 17:10 »), sans conversion de fuseau, par nom du champ horodatage. Un champ horodatage null n'y figure pas.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Horodatage Unix en secondes (corrigé en 0.9.0 : fuseau de l'établissement)."
    },
    "stableCode": {
      "type": "string",
      "enum": [
        "rate_limited",
        "session_expired",
        "session_replaced",
        "login_failed",
        "pronote_unavailable",
        "pronote_format_changed",
        "not_found",
        "ambiguous",
        "forbidden",
        "validation_failed",
        "duplicate_write",
        "web_session_required",
        "web_session_expired",
        "web_login_backoff",
        "collect_running",
        "internal"
      ]
    },
    "error": {
      "type": "object",
      "description": "Corps de toute réponse d'erreur (0.9.0). « error » garde la valeur historique (lue par local_pronoteio 2026112100).",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "$ref": "#/definitions/stableCode"
        },
        "message": {
          "type": "string"
        },
        "retry_after": {
          "type": "integer",
          "minimum": 1
        },
        "backoff_until": {
          "type": "integer",
          "minimum": 1,
          "description": "0.15.0 : instant (secondes Unix) avant lequel aucune connexion à l'Espace Professeurs web n'est envoyée à Pronote (web_login_backoff, web_session_required pendant le délai de reprise)."
        },
        "collectid": {
          "type": "string",
          "description": "0.16.0 : lecture groupée en cours du compte (collect_running)."
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "pronoteversion": {
          "type": "string"
        },
        "onglet": {
          "type": "integer",
          "description": "0.10.0 : onglet absent de la session (web_session_required, access_denied)."
        },
        "space": {
          "enum": [
            "mobile",
            "web"
          ],
          "description": "0.10.0 : espace où l'onglet manque (access_denied)."
        },
        "webtabs": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "validated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "integer",
          "minimum": 0,
          "description": "0.17.0 : cellules écrites avant la première non confirmée ou refusée (POST /reports/positioning : positioning_not_saved, pronote_refused, exclusive_mode)."
        }
      },
      "required": [
        "error",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
