{
  "name": "pronoteio-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Pronote sidecar service for the Moodle plugin local_pronoteio (Pawnote based).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "probe": "tsx --env-file=.env tools/probe.ts",
    "postinstall": "node -e \"const p=require('path');import(require('url').pathToFileURL(p.join(p.dirname(require('fs').realpathSync('package.json')),'tools','patch-pawnote.mjs')).href)\""
  },
  "dependencies": {
    "@literate.ink/utilities": "1.0.0-10641118381.1",
    "fastify": "^5.12.5",
    "node-forge": "^1.4.0",
    "pako": "^3.0.2",
    "pawnote": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
