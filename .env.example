# Shared secret, identical to the "Shared secret" setting of local_pronoteio (32+ random characters).
PRONOTEIO_SECRET=change-me
# Keep 127.0.0.1 unless Moodle runs on another host (then restrict with a firewall).
PRONOTEIO_HOST=127.0.0.1
PRONOTEIO_PORT=3900
# Idle lifetime of a cached Pronote session, in seconds (Pronote drops sessions after ~30 min).
PRONOTEIO_SESSION_TTL=1500
# Maximum clock difference accepted for signed requests: see PRONOTEIO_MAX_SKEW below (60 s since 0.9.0).
# Write mode: "simulate" (default) refuses every write to Pronote with the error write_mode_simulate,
# "live" allows them (the Moodle plugin has its own switch). Simulations (dryRun) always work.
# PRONOTEIO_ENABLE_GRADE_WRITE=true (older setting) is still accepted as an alias of "live".
PRONOTEIO_WRITE_MODE=simulate
# Rate limiter of the Pronote calls, per session (0.9.0): token bucket refilled at PRONOTEIO_MAX_CALLS_PER_MINUTE tokens
# per minute (0: no limit) up to PRONOTEIO_RATE_BURST tokens, calls spaced by PRONOTEIO_MIN_SPACING_MS. A call without
# token waits in the queue (writes, then unit reads, then bulk reads) up to PRONOTEIO_QUEUE_MAX_WAIT seconds, then gets
# 429 rate_limited with retry_after. PRONOTEIO_CALL_COSTS: cost of heavier functions ("FicheEleve=2,PageNotes=2").
PRONOTEIO_MAX_CALLS_PER_MINUTE=120
# PRONOTEIO_RATE_BURST=30
# PRONOTEIO_MIN_SPACING_MS=150
# PRONOTEIO_QUEUE_MAX_WAIT=20
# PRONOTEIO_CALL_COSTS=FicheEleve=2,PageBulletins=2,PageNotes=2,PageCahierDeTexte=2,PageReleve=2,RecapitulatifVSEleve=2
# 0.16.0 — lecture groupée d'une classe (POST /collect, voir README, « Suivi des classes ») : pause entre deux lectures
# internes (ms), et attente maximale d'une session fermée en cours de série avant de finir en « partial » (s).
# DetailsPIEleve, LivretScolaire, PageSuiviPluriannuel et RecapAbsencesEleves coûtent 2 jetons par défaut.
# PRONOTEIO_COLLECT_PAUSE_MS=250
# PRONOTEIO_COLLECT_WAIT=900

# Time zone of the school (0.9.0): Pronote wall-clock times are read in it. The newest time zone database is used,
# Node's own or the embedded "tzdata" package; PRONOTEIO_TZ_SOURCE=node|tzdata forces one (default auto).
# PRONOTEIO_TIMEZONE=Africa/Casablanca
# PRONOTEIO_TZ_SOURCE=auto
# Teacher-space function names found during the capture (see docs/capture.md).
# PRONOTEIO_FUNCTIONS_FILE=./pronote-functions.json

# 0.10.0 — Espace Professeurs web (voir README, « Espace Professeurs web ») :
# off : jamais de passage par la session web (comportement 0.9.0).
# PRONOTEIO_WEB_ROUTING=on
# Fonctions laissées sur la session mobile bien que leur onglet n'y soit pas listé.
# PRONOTEIO_MOBILE_WITHOUT_TAB=ListePeriodes,PageTrombinoscope,listeQCM
# genreReferentiel de CompetencesGrilles pour « Référentiels par matière » (non validé).
# PRONOTEIO_REFERENTIAL_GENRE=1

# Discovery tool only (tools/probe.ts). Never commit real values.
# PROBE_URL=https://<code-etablissement>.index-education.net/pronote/professeur.html
# PROBE_USERNAME=
# PROBE_PASSWORD=
# Double authentication PIN, only needed at the first run (the device is then trusted, see .probe-token).
# PROBE_PIN=
PRONOTEIO_LOG_LEVEL=info

# Chain of the single-use Pronote tokens, encrypted with PRONOTEIO_SECRET (src/tokenStore.ts): a login answer lost
# on the way (timeout, restart) no longer breaks the link. Default: var/tokens.json in the application folder.
# "off" disables it (a lost answer then means linking the account again).
# PRONOTEIO_TOKEN_STORE=var/tokens.json

# Short cache of the reads, in memory only (0.9.0, RGPD: never on disk, lost at restart): lifetime in seconds
# (0 disables it), per route with PRONOTEIO_CACHE_TTLS, size limit in MB.
# PRONOTEIO_CACHE_TTL=60
# PRONOTEIO_CACHE_TTLS=/students/files=60,/roster=120
# PRONOTEIO_CACHE_MAX_MB=20

# Single process and session (0.9.0). Lock file of the process ("off" disables the check); state file of the
# non-personal counters kept across restarts ("off": memory only); keep-alive interval of the Pronote sessions (s).
# PRONOTEIO_LOCK_FILE=~/tmp/pronoteio-sidecar.lock
# 0.15.0: the state file also keeps the back-off of the web logins (after a refusal by Pronote, no web login of the
# account is sent before 60 s, 2 min, 5 min, 15 min): with "off", a restart forgets it.
# PRONOTEIO_STATE_FILE=var/state.json
# PRONOTEIO_PRESENCE_INTERVAL=120

# Pronote versions validated (0.9.0): on another version reads stay allowed, writes are refused
# (pronote_format_changed, reason unvalidated_version) unless PRONOTEIO_ALLOW_UNVALIDATED_WRITES=true.
# PRONOTEIO_FORMAT_CHECK=off disables the check of the answer formats (emergency only).
# PRONOTEIO_VALIDATED_VERSIONS=2026.2.8
# PRONOTEIO_ALLOW_UNVALIDATED_WRITES=false

# Access log without personal data (0.9.0): one JSON line per request (route pattern, status, code, duration, size),
# rotated by size. "off" disables it.
# PRONOTEIO_LOG_FILE=~/logs/pronoteio-sidecar.log
# PRONOTEIO_LOG_MAX_MB=5
# PRONOTEIO_LOG_FILES=5

# Update on demand (0.9.0): POST /admin/update runs tools/cpanel-update.sh with this public URL ("off" disables it).
# PRONOTEIO_PUBLIC_URL=https://sidecar.example.org
# PRONOTEIO_ADMIN_UPDATE=on

# Security of the signed exchange (0.9.0): window of a signature in seconds (60), previous secret(s) still accepted
# during a rotation (comma separated; the token chain written with them stays readable), nonce required, addresses
# allowed (Moodle server: exact IPs or IPv4 CIDR; empty: any), trust X-Forwarded-For (default: under Passenger only).
PRONOTEIO_MAX_SKEW=60
# PRONOTEIO_SECRET_PREVIOUS=
# PRONOTEIO_REQUIRE_NONCE=true
# PRONOTEIO_ALLOWED_IPS=
# PRONOTEIO_TRUST_PROXY=
