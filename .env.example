# Shared secret, identical to the "Shared secret" setting of local_pronoteio (32+ random characters).
PRONOTEIO_SECRET=change-me
# Keep 127.0.0.1 unless Moodle runs on another host (then restrict with a firewall).
PRONOTEIO_HOST=127.0.0.1
PRONOTEIO_PORT=3900
# Idle lifetime of a cached Pronote session, in seconds (Pronote drops sessions after ~30 min).
PRONOTEIO_SESSION_TTL=1500
# Maximum clock difference accepted for signed requests, in seconds.
PRONOTEIO_MAX_SKEW=300
# Write mode: "simulate" (default) refuses every write to Pronote with the error write_mode_simulate,
# "live" allows them (the Moodle plugin has its own switch). Simulations (dryRun) always work.
# PRONOTEIO_ENABLE_GRADE_WRITE=true (older setting) is still accepted as an alias of "live".
PRONOTEIO_WRITE_MODE=simulate
# Pronote calls allowed per session and per minute (0: no limit); calls are also spaced by 150 ms.
PRONOTEIO_MAX_CALLS_PER_MINUTE=120
# Teacher-space function names found during the capture (see docs/capture.md).
# PRONOTEIO_FUNCTIONS_FILE=./pronote-functions.json

# Discovery tool only (tools/probe.ts). Never commit real values.
# PROBE_URL=https://<code-etablissement>.index-education.net/pronote/professeur.html
# PROBE_USERNAME=
# PROBE_PASSWORD=
# Double authentication PIN, only needed at the first run (the device is then trusted, see .probe-token).
# PROBE_PIN=
PRONOTEIO_LOG_LEVEL=info
